#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_par {
            bindings = <&kp N9>;
            key-positions = <14 13>;
        };

        right_par {
            bindings = <&kp NUMBER_0>;
            key-positions = <15 16>;
        };

        left_brace {
            bindings = <&kp LS(GREATER_THAN)>;
            key-positions = <24 23>;
        };

        right_brace {
            bindings = <&kp LS(SLASH)>;
            key-positions = <25 26>;
        };

        less {
            bindings = <&kp RA(O)>;
            key-positions = <3 2>;
        };

        more {
            bindings = <&kp RA(P)>;
            key-positions = <6 7>;
        };

        left_round_par {
            bindings = <&kp DOT>;
            key-positions = <22 23>;
        };

        right_round_par {
            bindings = <&kp SLASH>;
            key-positions = <26 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q        &kp W        &kp E         &kp R         &hml RA(T) T                               &kp Y  &kp U         &hmr RA(I) I  &kp O        &kp P
  &hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F  &kp G                                      &kp H  &hmr RCTRL J  &hmr RSHFT K  &hmr LALT L  &hmr RGUI SEMICOLON
  &kp Z        &kp X        &kp C         &kp V         &kp B                                      &kp N  &hmr RA(M) M  &kp COMMA     &kp DOT      &kp SLASH
                                          &kp TAB       &lt 2 SPACE   &kp ESCAPE    &kp BACKSPACE  &mo 1  &kp ENTER
            >;

            display-name = "Base";
        };

        sym {
            bindings = <
  &kp LS(BACKSLASH)  &kp RA(GRAVE)    &kp N7                 &kp NUMBER_1            &kp SEMI                              &kp PLUS   &kp NUMBER_1         &kp NUMBER_2         &kp NUMBER_3        &none
  &hml LGUI BSLH     &hml LALT GRAVE  &hml LSHFT LEFT_BRACE  &hml LCTRL RIGHT_BRACE  &kp NUMBER_2                          &kp MINUS  &hmr RCTRL NUMBER_4  &hmr RSHFT NUMBER_5  &hmr LALT NUMBER_6  &hmr RGUI N0
  &kp RA(BACKSLASH)  &kp LS(GRAVE)    &kp LS(LEFT_BRACE)     &kp LS(RIGHT_BRACE)     &kp UNDERSCORE                        &kp EQUAL  &kp NUMBER_7         &kp N8               &kp N9              &none
                                                             &kp CAPSLOCK            &trans          &kp DELETE    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        nav {
            bindings = <
  &kp LC(Q)            &kp LC(W)            &kp LC(E)              &kp LC(R)                &kp LC(T)                    &kp HOME        &kp PAGE_DOWN          &kp PAGE_UP          &kp END                &kp PRINTSCREEN
  &hml LEFT_GUI LC(A)  &hml LEFT_ALT LC(S)  &hml LEFT_SHIFT LC(D)  &hml LEFT_CONTROL LC(F)  &kp LC(G)                    &kp LEFT_ARROW  &hmr RCTRL DOWN_ARROW  &hmr RSHFT UP_ARROW  &hmr LALT RIGHT_ARROW  &hmr RIGHT_GUI RIGHT_GUI
  &kp LC(Z)            &kp LC(X)            &kp LC(C)              &kp LC(V)                &kp LC(B)                    &none           &none                  &none                &none                  &none
                                                                   &trans                   &trans     &trans    &trans  &trans          &trans
            >;

            display-name = "Nav";
        };

        Flash {
            bindings = <
  &kp F11  &kp F3  &kp F2  &kp F1  &kp C_VOLUME_UP                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
  &kp F10  &kp F6  &kp F5  &kp F4  &kp C_VOLUME_DOWN                    &none         &none         &none         &none         &none
  &kp F12  &kp F9  &kp F8  &kp F7  &kp K_MUTE                           &out OUT_USB  &none         &none         &none         &studio_unlock
                           &trans  &trans             &trans    &trans  &trans        &trans
            >;

            display-name = "Flash";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Flash {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
